# Salin menjadi .env — dibaca oleh `npm run dev` dan `docker compose`

# --- Database ---
# npm run dev (Next.js di Windows, Postgres di Docker):
DATABASE_URL=postgres://jobtracker:jobtracker@localhost:5432/jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=jobtracker
POSTGRES_DB=jobtracker

# --- Login (Auth.js) ---
# String acak panjang. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Alamat aplikasi. Lokal: http://localhost:3000
AUTH_URL=http://localhost:3000

# Login GitHub — github.com > Settings > Developer settings > OAuth Apps
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Login Google — console.cloud.google.com > APIs & Services > Credentials > OAuth client ID
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Tombol login hanya muncul untuk provider yang ID dan SECRET-nya diisi.

# Opsional: batasi siapa yang boleh login (pisahkan dengan koma). Kosong = semua orang boleh login.
ALLOWED_EMAILS=
